PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/gamepeak.sqlite
NODE_ENV=development
# Debug requires BOTH development mode and this explicit flag.
ENABLE_DEBUG=false
# For LAN testing set HOST=0.0.0.0. Vite proxies /api and /ws.
# Production: NODE_ENV=production, HTTPS reverse proxy, persistent data volume.
# Comma-separated browser origins for WebSocket and HTTP origin validation.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# Local npm run dev uses the Vite proxies; no VITE_* variables needed.
# Render: HOST=0.0.0.0, NODE_ENV=production, use Render's PORT.
# Render: ALLOWED_ORIGINS=https://game-peak.vercel.app
# SQLite needs a persistent disk and a single backend instance.
# DATABASE_PATH=/var/data/gamepeak.sqlite

# Vercel production build (redeploy after changing variables):
# VITE_API_URL=https://game-peak.onrender.com
# Optional: defaults to VITE_API_URL's host + /ws.
# VITE_WS_URL=wss://game-peak.onrender.com/ws
# Legacy VITE_COLYSEUS_URL is accepted, but is also a native JSON /ws endpoint.
# Do not point API and WS to separate services with separate SQLite databases.

# Only for npm run start:colyseus locally; PORT takes precedence.
# COLYSEUS_PORT=2567

# Supabase is NOT wired into the runtime yet. DATABASE_URL, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY and VITE_SUPABASE_* currently have no effect.
# Never put service-role keys or database credentials into VITE_* variables.
