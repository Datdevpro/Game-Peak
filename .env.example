PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/gamepeak.sqlite
NODE_ENV=development
# Debug requires BOTH development mode and this explicit flag.
ENABLE_DEBUG=false
# For LAN testing set HOST=0.0.0.0. Vite proxies /api and /ws.
# Production: NODE_ENV=production, HTTPS reverse proxy, persistent data volume.
# Comma-separated browser origins for WebSocket and HTTP origin validation.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
